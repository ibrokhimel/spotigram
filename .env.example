# BotFather token — https://t.me/BotFather
TELEGRAM_BOT_TOKEN=

# Always includes 1406109190. Comma-separate extra admins if needed.
TELEGRAM_ADMIN_IDS=1406109190

# my.telegram.org — required for the local Bot API (2 GB uploads)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Inside Docker Compose this is the Bot API service. Leave empty to use
# api.telegram.org (50 MB cap) for a quick local test.
TELEGRAM_BOT_API_URL=http://telegram-bot-api:8081

# Spotify Developer Dashboard — https://developer.spotify.com/dashboard
# Redirect URI must be exactly:
#   http://127.0.0.1:8888/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8888/callback

# Optional. If empty, a key is generated at data/secret.key
SPOTIGRAM_SECRET=

MAX_CONCURRENT_JOBS=2
MAX_TRACKS_PER_JOB=200
WARN_TRACKS=40
ZIP_MAX_MB=1900
ADMIN_HANDLE=@ibrokhimel
